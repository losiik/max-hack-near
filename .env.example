# Пример переменных окружения для корневого docker-compose.yml.
# Скопируйте файл в .env и при необходимости замените значения.
# Рабочих токенов, паролей и ключей здесь нет: все значения ниже dev-заглушки
# или пустые поля, которые надо заполнить самостоятельно.
# Подробное описание каждой переменной: раздел «Переменные окружения» в README.md.

# Локальный запуск: без COMPOSE_PROFILES=local frontend и nginx не поднимаются,
# и compose нужно запускать с флагом --profile local.
COMPOSE_PROFILES=local

# dev разрешает вход тестовыми пользователями и dev-ящик сообщений бота; в
# production должно быть prod.
APP_ENV=dev

# PostgreSQL
POSTGRES_USER=assist
POSTGRES_PASSWORD=assist
POSTGRES_DB=assist
DATABASE_URL=postgresql+asyncpg://assist:assist@postgres:5432/assist
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5433

# Секреты API: ключ подписи токенов входа и ключ Fernet для шифрования личных
# данных в базе. Значения ниже подходят только для локальной разработки.
JWT_SECRET=dev-secret-change-me-32-bytes-minimum
FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Адреса frontend, которым API разрешает запросы
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Бот MAX. Без токена сообщения бота видны только в dev-ящике на экране входа.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=t562_hakaton_max_bot

# Вход для автоматической проверки API (роль review). Пока пароль пустой или
# короче 16 символов, вход закрыт даже в production.
REVIEW_LOGIN=review
REVIEW_PASSWORD=

# Цифровой сотрудник: Yandex AI Studio. Без ключа кнопка «Цифровой сотрудник»
# отвечает «сейчас недоступен».
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
AI_LLM_MODEL=qwen3-235b-a22b-fp8/latest
AI_VOICE=dasha

# LiveKit: голосовые комнаты
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-livekit-secret-change-me-32-bytes
LIVEKIT_BIND_ADDRESS=127.0.0.1
LIVEKIT_CONFIG_FILE=./livekit/livekit.yaml
LIVEKIT_EGRESS_CONFIG_FILE=./livekit/egress.yaml
# IP, который LiveKit сообщает браузеру. Для проверки с телефона в той же
# сети замените на LAN-адрес компьютера, например 192.168.1.10.
LIVEKIT_NODE_IP=127.0.0.1
# Пользователь, от которого Egress пишет файлы в recordings/.
EGRESS_USER=1001:0
RECORDINGS_VOLUME=./recordings

# Порты и адреса на хосте
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

# Сборка frontend: development разрешает вход тестовыми пользователями в
# обычном браузере
FRONTEND_BUILD_MODE=development
VITE_API_BASE_URL=/api/v1
