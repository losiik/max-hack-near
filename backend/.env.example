# Пример настроек. Скопируйте в backend/.env: его читают backend при запуске без Docker
# и make deploy-local. Для docker compose up без make этот файл не нужен — значения ниже
# совпадают со значениями по умолчанию из docker-compose.yml. Описание — README, раздел «Переменные окружения».

# ---- Общие для Docker и backend ----
APP_ENV=dev
JWT_SECRET=dev-secret-change-me-32-bytes-minimum
FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3048
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=t562_hakaton_max_bot
# ответ на /start: MAX шлёт события на этот адрес (только https, порт 443) с секретом в заголовке
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=
# вход для проверки жюри; пустой пароль — вход закрыт
REVIEW_LOGIN=review
REVIEW_PASSWORD=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
AI_LLM_MODEL=qwen3-235b-a22b-fp8/latest
AI_VOICE=dasha
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-livekit-secret-change-me-32-bytes

# ---- Только Docker Compose ----
POSTGRES_USER=assist
POSTGRES_PASSWORD=assist
POSTGRES_DB=assist
LIVEKIT_NODE_IP=127.0.0.1
# порт локального Nginx с приложением: http://localhost:3048
WEB_PORT=3048
API_PORT=8000
POSTGRES_PORT=5433
FRONTEND_BUILD_MODE=development

# ---- Только backend без Docker (в Compose эти значения заданы в docker-compose.yml) ----
# в Docker: postgresql+asyncpg://assist:assist@postgres:5432/assist
DATABASE_URL=postgresql+asyncpg://assist:assist@localhost:5433/assist
# в Docker: http://livekit:7880
LIVEKIT_API_URL=http://localhost:7880
JWT_TTL_HOURS=12
MAX_API_BASE=https://platform-api.max.ru
INIT_DATA_MAX_AGE_SECONDS=86400
VOICE_TOKEN_TTL_SECONDS=120
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=60
RETENTION_INBOX_HOURS=24
RETENTION_INVITES_DAYS=7
RETENTION_DRAFTS_DAYS=30
RETENTION_CALLBACKS_DAYS=7
RETENTION_SUBMITTED_DAYS=90
DB_SIZE_WARNING_MB=1024
EXPIRY_ENABLED=true
EXPIRY_INTERVAL_SECONDS=60
ASSIST_WAITING_TIMEOUT_MINUTES=30
ASSIST_IDLE_TIMEOUT_MINUTES=60
HELP_CALLBACK_TTL_DAYS=7
